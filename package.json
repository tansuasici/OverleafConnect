{
  "name": "overleaf-connect",
  "displayName": "Overleaf Connect",
  "description": "Use Overleaf without leaving VS Code. Syncs Overleaf projects via Git; Overtex builds and previews them.",
  "version": "0.2.1",
  "publisher": "tansuasici",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "latex",
    "overleaf",
    "git",
    "sync",
    "tex"
  ],
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tansuasici/OverleafConnect"
  },
  "homepage": "https://github.com/tansuasici/OverleafConnect#readme",
  "bugs": {
    "url": "https://github.com/tansuasici/OverleafConnect/issues"
  },
  "main": "./out/extension.js",
  "extensionDependencies": [
    "tansuasici.overtex"
  ],
  "activationEvents": [
    "workspaceContains:**/*.tex",
    "workspaceContains:.overleafconnect",
    "onCommand:overleafconnect.configure",
    "onCommand:overleafconnect.cloneProject"
  ],
  "contributes": {
    "commands": [
      {
        "command": "overleafconnect.configure",
        "title": "Configure Overleaf Connection",
        "category": "Overleaf Connect"
      },
      {
        "command": "overleafconnect.cloneProject",
        "title": "Clone Overleaf Project",
        "category": "Overleaf Connect"
      },
      {
        "command": "overleafconnect.syncNow",
        "title": "Sync Now",
        "category": "Overleaf Connect",
        "icon": "$(sync)"
      },
      {
        "command": "overleafconnect.pauseSync",
        "title": "Pause Auto-Sync",
        "category": "Overleaf Connect",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overleafconnect.resumeSync",
        "title": "Resume Auto-Sync",
        "category": "Overleaf Connect",
        "icon": "$(debug-start)"
      },
      {
        "command": "overleafconnect.showLog",
        "title": "Show Sync Log",
        "category": "Overleaf Connect"
      },
      {
        "command": "overleafconnect.logout",
        "title": "Clear Overleaf Credentials",
        "category": "Overleaf Connect"
      },
      {
        "command": "overleafconnect.syncFolder",
        "title": "Sync This Folder",
        "category": "Overleaf Connect",
        "icon": "$(sync)"
      },
      {
        "command": "overleafconnect.pauseFolder",
        "title": "Pause This Folder",
        "category": "Overleaf Connect",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overleafconnect.resumeFolder",
        "title": "Resume This Folder",
        "category": "Overleaf Connect",
        "icon": "$(debug-start)"
      },
      {
        "command": "overleafconnect.refreshView",
        "title": "Refresh Overleaf Panel",
        "category": "Overleaf Connect",
        "icon": "$(refresh)"
      },
      {
        "command": "overleafconnect.showConflict",
        "title": "Compare with Overleaf",
        "category": "Overleaf Connect",
        "icon": "$(diff)"
      },
      {
        "command": "overleafconnect.takeOverleaf",
        "title": "Take Overleaf's Version",
        "category": "Overleaf Connect",
        "icon": "$(cloud-download)"
      },
      {
        "command": "overleafconnect.keepMine",
        "title": "Keep My Version",
        "category": "Overleaf Connect",
        "icon": "$(account)"
      },
      {
        "command": "overleafconnect.openMerged",
        "title": "Edit Conflict by Hand",
        "category": "Overleaf Connect",
        "icon": "$(edit)"
      },
      {
        "command": "overleafconnect.markResolved",
        "title": "Mark as Resolved",
        "category": "Overleaf Connect",
        "icon": "$(check)"
      },
      {
        "command": "overleafconnect.abortMerge",
        "title": "Abort Merge",
        "category": "Overleaf Connect",
        "icon": "$(discard)"
      },
      {
        "command": "overleafconnect.showRemoteCommit",
        "title": "Show Changes",
        "category": "Overleaf Connect",
        "icon": "$(diff)"
      },
      {
        "command": "overleafconnect.openInOverleaf",
        "title": "Open in Overleaf",
        "category": "Overleaf Connect",
        "icon": "$(link-external)"
      },
      {
        "command": "overleafconnect.uploadFolder",
        "title": "Upload Folder to Overleaf Project",
        "category": "Overleaf Connect",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "overleafconnect.setSessionCookie",
        "title": "Set Overleaf Session Cookie",
        "category": "Overleaf Connect"
      },
      {
        "command": "overleafconnect.compileOnOverleaf",
        "title": "Compile on Overleaf",
        "category": "Overleaf Connect",
        "icon": "$(file-pdf)"
      },
      {
        "command": "overleafconnect.showComments",
        "title": "Show Overleaf Comments",
        "category": "Overleaf Connect",
        "icon": "$(comment-discussion)"
      }
    ],
    "configuration": {
      "title": "Overleaf Connect",
      "properties": {
        "overleafconnect.sync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic sync with Overleaf."
        },
        "overleafconnect.sync.intervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 600,
          "description": "Auto-sync interval in seconds."
        },
        "overleafconnect.sync.commitMessage": {
          "type": "string",
          "default": "Overleaf Connect auto-sync",
          "description": "Default commit message for auto-sync pushes."
        },
        "overleafconnect.sync.pullOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Pull latest changes when opening the workspace."
        },
        "overleafconnect.sync.pushOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Push immediately after saving (in addition to interval sync)."
        },
        "overleafconnect.sync.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.aux",
            "*.log",
            "*.synctex.gz",
            "*.fls",
            "*.fdb_latexmk",
            "*.bbl",
            "*.blg",
            "*.out",
            "*.toc",
            "*.pdf",
            "*.nav",
            "*.snm",
            "*.vrb",
            "*.lot",
            "*.lof",
            "%OUTDIR%/"
          ],
          "description": "File patterns to exclude from sync (added to .gitignore)."
        },
        "overleafconnect.overleaf.serverUrl": {
          "type": "string",
          "default": "https://git.overleaf.com",
          "description": "Overleaf Git server URL (change for self-hosted instances)."
        },
        "overleafconnect.notifications.remoteChanges": {
          "type": "string",
          "enum": [
            "notification",
            "statusBar",
            "off"
          ],
          "enumDescriptions": [
            "Show a notification with a button to compare the changed files.",
            "Show a short message in the status bar.",
            "Say nothing; changes still appear in the Overleaf panel."
          ],
          "default": "notification",
          "description": "How to tell you that a sync brought in changes made on Overleaf."
        }
      }
    },
    "keybindings": [
      {
        "command": "overleafconnect.syncNow",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overleafconnect",
          "title": "Overleaf",
          "icon": "media/icons/overleaf-sync.svg"
        }
      ]
    },
    "views": {
      "overleafconnect": [
        {
          "id": "overleafconnect.syncView",
          "name": "Sync",
          "icon": "media/icons/overleaf-sync.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overleafconnect.syncView",
        "when": "!overleafconnect.connected",
        "contents": "No folder is connected to an Overleaf project.\n[Connect This Folder](command:overleafconnect.configure)\n[Clone Overleaf Project](command:overleafconnect.cloneProject)\n[Upload Folder to Overleaf Project](command:overleafconnect.uploadFolder)"
      }
    ],
    "colors": [
      {
        "id": "overleafconnect.pendingResourceForeground",
        "description": "Explorer color for files that are not on Overleaf yet.",
        "defaults": {
          "dark": "#6CB6FF",
          "light": "#0969DA",
          "highContrast": "#6CB6FF",
          "highContrastLight": "#0969DA"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "overleafconnect.syncNow",
          "when": "view == overleafconnect.syncView && overleafconnect.connected",
          "group": "navigation@1"
        },
        {
          "command": "overleafconnect.pauseSync",
          "when": "view == overleafconnect.syncView && overleafconnect.connected && !overleafconnect.paused",
          "group": "navigation@2"
        },
        {
          "command": "overleafconnect.resumeSync",
          "when": "view == overleafconnect.syncView && overleafconnect.paused",
          "group": "navigation@2"
        },
        {
          "command": "overleafconnect.refreshView",
          "when": "view == overleafconnect.syncView",
          "group": "navigation@3"
        },
        {
          "command": "overleafconnect.configure",
          "when": "view == overleafconnect.syncView",
          "group": "more@1"
        },
        {
          "command": "overleafconnect.showLog",
          "when": "view == overleafconnect.syncView",
          "group": "more@2"
        },
        {
          "command": "overleafconnect.setSessionCookie",
          "when": "view == overleafconnect.syncView",
          "group": "more@3"
        }
      ],
      "view/item/context": [
        {
          "command": "overleafconnect.openInOverleaf",
          "when": "view == overleafconnect.syncView && viewItem =~ /^overleafFolder/",
          "group": "inline@3"
        },
        {
          "command": "overleafconnect.syncFolder",
          "when": "view == overleafconnect.syncView && viewItem =~ /^overleafFolder/",
          "group": "inline@1"
        },
        {
          "command": "overleafconnect.pauseFolder",
          "when": "view == overleafconnect.syncView && viewItem == overleafFolder",
          "group": "inline@2"
        },
        {
          "command": "overleafconnect.resumeFolder",
          "when": "view == overleafconnect.syncView && viewItem == overleafFolder.paused",
          "group": "inline@2"
        },
        {
          "command": "overleafconnect.takeOverleaf",
          "when": "view == overleafconnect.syncView && viewItem == overleafConflict",
          "group": "inline@1"
        },
        {
          "command": "overleafconnect.keepMine",
          "when": "view == overleafconnect.syncView && viewItem == overleafConflict",
          "group": "inline@2"
        },
        {
          "command": "overleafconnect.openMerged",
          "when": "view == overleafconnect.syncView && viewItem == overleafConflict",
          "group": "inline@3"
        },
        {
          "command": "overleafconnect.markResolved",
          "when": "view == overleafconnect.syncView && viewItem == overleafConflict",
          "group": "inline@4"
        },
        {
          "command": "overleafconnect.showConflict",
          "when": "view == overleafconnect.syncView && viewItem == overleafConflict",
          "group": "conflict@1"
        },
        {
          "command": "overleafconnect.abortMerge",
          "when": "view == overleafconnect.syncView && viewItem == overleafFolder.conflict",
          "group": "inline@2"
        },
        {
          "command": "overleafconnect.compileOnOverleaf",
          "when": "view == overleafconnect.syncView && viewItem =~ /^overleafFolder/",
          "group": "inline@4"
        },
        {
          "command": "overleafconnect.showComments",
          "when": "view == overleafconnect.syncView && viewItem =~ /^overleafFolder/",
          "group": "web@1"
        },
        {
          "command": "overleafconnect.compileOnOverleaf",
          "when": "view == overleafconnect.syncView && viewItem =~ /^overleafFolder/",
          "group": "web@2"
        }
      ],
      "commandPalette": [
        {
          "command": "overleafconnect.syncFolder",
          "when": "false"
        },
        {
          "command": "overleafconnect.pauseFolder",
          "when": "false"
        },
        {
          "command": "overleafconnect.resumeFolder",
          "when": "false"
        },
        {
          "command": "overleafconnect.showConflict",
          "when": "false"
        },
        {
          "command": "overleafconnect.takeOverleaf",
          "when": "false"
        },
        {
          "command": "overleafconnect.keepMine",
          "when": "false"
        },
        {
          "command": "overleafconnect.openMerged",
          "when": "false"
        },
        {
          "command": "overleafconnect.markResolved",
          "when": "false"
        },
        {
          "command": "overleafconnect.abortMerge",
          "when": "false"
        },
        {
          "command": "overleafconnect.showRemoteCommit",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "webpack --mode production --devtool hidden-source-map",
    "webpack": "webpack --mode development",
    "webpack-dev": "webpack --mode development --watch",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@types/mocha": "^10.0.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "mocha": "^10.2.0",
    "sinon": "^17.0.0",
    "@types/sinon": "^17.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "ts-loader": "^9.5.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}
